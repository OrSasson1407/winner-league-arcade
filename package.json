{
  "name": "winner-league-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Winner League Arcade: Israeli Premier League games with online 1v1",
  "scripts": {
    "start": "node server/index.js",
    "build:rtl": "node game/tools/build_rtl.mjs",
    "i18n:missing": "node game/tools/extract_ui_strings.mjs --missing",
    "test": "node server/test/db.test.mjs && node server/test/db.pg.test.mjs",
    "build:fonts": "node game/tools/build_fonts.mjs",
    "build:national-teams": "node --use-system-ca game/tools/build_national_teams_2025_2027.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "acorn": "^8.19.0",
    "axe-core": "^4.13.0",
    "rtlcss": "^4.3.0",
    "pdfjs-dist": "^6.4.299"
  }
}
